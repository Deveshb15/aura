<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Carpet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Carpet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Carpet — local capture vault</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Link previews fetch images/favicons from arbitrary sites, some over http. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- Sparkle auto-updates. Feed served from GitHub Pages; archives are the
	     GitHub Release DMGs, each EdDSA-signed (public key below). -->
	<key>SUFeedURL</key>
	<string>https://deveshb15.github.io/aura/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>twVxJcgKa1TiNb9AlIj/hia3ts2AD98hfGyZF7H0qJ4=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Check once a week (604800s). -->
	<key>SUScheduledCheckInterval</key>
	<integer>604800</integer>
	<!-- Never install silently — always show the Install / Remind Me Later / Skip panel. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUShowReleaseNotes</key>
	<true/>
</dict>
</plist>
