{
  "manifest_version": 3,
  "name": "Aura — X bookmark sync",
  "version": "0.1.0",
  "description": "Save your X (Twitter) bookmarks into your local Aura library. Passive: reads only the bookmarks page's own data while you browse.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Aura — X bookmark sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "//key": "Pins a stable extension ID (gmombdkcjjnlgcbfanhcfgabpjkajdbn) so Aura's native-messaging host can whitelist this extension even when loaded unpacked. Generated from a throwaway RSA keypair; the private half is never needed to load unpacked.",
  "key": "",

  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x-graphql-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/x-bookmark-watcher.js"],
      "run_at": "document_end"
    }
  ]
}
